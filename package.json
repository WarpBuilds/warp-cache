{
  "name": "@warpbuilds/cache",
  "version": "2.0.0-0",
  "description": "Cache client library for WarpBuild's cache service",
  "keywords": [
    "github",
    "actions",
    "cache",
    "warpbuild"
  ],
  "homepage": "https://github.com/WarpBuilds/warp-cache",
  "license": "MIT",
  "type": "module",
  "main": "lib/cache.js",
  "types": "lib/cache.d.ts",
  "exports": {
    ".": {
      "types": "./lib/cache.d.ts",
      "import": "./lib/cache.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "files": [
    "lib",
    "!.DS_Store"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WarpBuilds/warp-cache.git"
  },
  "scripts": {
    "build": "tsc",
    "tsc": "tsc",
    "test": "jest",
    "audit-moderate": "npm install && npm audit --json --audit-level=moderate > audit.json"
  },
  "bugs": {
    "url": "https://github.com/WarpBuilds/warp-cache/issues"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1",
    "@actions/glob": "^0.7.0",
    "@actions/http-client": "^4.0.1",
    "@actions/io": "^3.0.2",
    "@azure/storage-blob": "^12.33.0",
    "@google-cloud/storage": "^7.17.1",
    "@octokit/webhooks-types": "^7.6.1",
    "axios": "^1.18.1",
    "google-auth-library": "^9.15.1",
    "semver": "^7.7.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.3",
    "@types/semver": "^7.7.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "brace-expansion": "^5.0.8"
  }
}

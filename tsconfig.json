{
  "compilerOptions": {
    "esModuleInterop": true,
    "module": "commonjs",
    "strict": true,
    "declaration": true,
    "target": "es6",
    "skipLibCheck": true,
    "sourceMap": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "baseUrl": "./",
    "outDir": "./lib",
    "rootDir": "./src",
    "lib": [
      "es6",
      "dom"
    ]
  },
  "include": [
    "./src"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/__mocks__/*"
  ]
}
